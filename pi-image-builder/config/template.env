# Filled in by build.sh into the image's own /opt/blynk/blynk.env - the
# same fields install.sh would otherwise prompt for interactively.
#
# BLYNK_AUTH_TOKEN is deliberately NOT here: it's the one genuinely
# per-device secret, and has to come from the Blynk app during BLE
# provisioning. Server and template ID are known upfront for a whole
# product line, so they're baked in here just like the vendor prefix.

# e.g. lon1.blynk.cloud - required
BLYNK_SERVER=lon1.blynk.cloud

# Identifies the product itself - required
BLYNK_TEMPLATE_ID=TMPL5sBpFtib0

# Only relevant for Blynk Enterprise clients running their own server and
# a branded mobile app - replaces "Blynk" in the BLE-advertised device
# name and the provisioning "vendor" field. Leave blank for the normal
# Blynk Cloud/app (defaults to "Blynk").
BLYNK_VENDOR_PREFIX=
